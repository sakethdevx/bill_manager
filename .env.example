# Copy to .env for local development (Vercel: add the same names under Project -> Settings -> Environment Variables)

# --- Website login (shared) ---
APP_USERNAME=owner@example.com
APP_PASSWORD=choose-a-long-password
# Random string used to sign the login cookie (any 32+ characters).  Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Data storage: a PRIVATE GitHub repository (can belong to a different account) ---
# Fine-grained personal access token of the account that owns the data repo, limited to that one repo,
# permission "Contents: Read and write".
GITHUB_TOKEN=
# owner/name of the private data repo, e.g. my-shop-account/bill-manager-data
GITHUB_REPO=
GITHUB_BRANCH=main
# Leave GITHUB_TOKEN / GITHUB_REPO empty while developing locally: data is then kept in the .data/ folder instead.
