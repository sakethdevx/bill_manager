{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": null,
    "outputDirectory": "public",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*)\\.(js|css)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        }
    ]
}
